[Unit]
Description=Land Parcel Monitor
After=network.target
Wants=network-online.target

[Service]
Type=exec
User=landmonitor
Group=landmonitor
WorkingDirectory=/opt/land-monitor/backend
EnvironmentFile=/opt/land-monitor/.env
ExecStart=/opt/land-monitor/venv/bin/python -m uvicorn main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 1 \
    --log-level info
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=land-monitor

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/land-monitor/data /opt/land-monitor/backend/__pycache__

[Install]
WantedBy=multi-user.target
