identity:
  context: ["<Role, industry, setting>"]
  jobs_to_be_done:
    - title: ""
      when: ""
      i_want_to: ""
      so_i_can: ""
      functional_success: ""
      emotional_success: ""
      social_success: ""
  fundamental_motivations: ["<Behavior/value, not demographic>"]

context:
  technology:
    primary_device: ""
